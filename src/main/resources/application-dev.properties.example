# Desenvolvimento - configuracoes locais

spring.datasource.url=jdbc:postgresql://localhost:5432/beatmanager
spring.datasource.username=postgres
spring.datasource.password=SUA_SENHA

server.port=8082

jwt.secret=SUA_SECRET_KEY_BASE64

# CORS
cors.allowed-origins=http://localhost:3000

# Upload
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Cloudinary
cloudinary.cloud-name=SEU_CLOUD_NAME
cloudinary.api-key=SUA_API_KEY
cloudinary.api-secret=SUA_API_SECRET
